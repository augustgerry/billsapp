{
  "expo": {
    "name": "Kongsi",
    "slug": "billsapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "billsapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FACC15",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F6F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B0B0C",
            "image": "./assets/images/splash-icon-dark.png",
            "imageWidth": 132
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kongsi needs photo access so you can attach a transfer receipt.",
          "cameraPermission": "Kongsi needs camera access so you can snap a transfer receipt."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#FACC15"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
