# Copy to `.env` and fill in from your Supabase project
# (Dashboard -> Project Settings -> API). Both are safe to ship in the client.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-public-key

# --- Edge Function secrets (NOT prefixed EXPO_PUBLIC_, never in the app bundle) ---
# Set on the server:  supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
